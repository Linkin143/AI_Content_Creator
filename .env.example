# ============================================================================
# AEVRIX Content Intelligence Engine - Environment Configuration
# Copy this file to `.env` and fill in only what you need.
# The app runs in research + manual mode even with most of this left blank.
# NEVER commit your real .env file. NEVER paste employer/company credentials.
# ============================================================================

# ---- Application ----------------------------------------------------------
APP_ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
# Password (plaintext here -> hashed on first dashboard login) for the admin UI
DASHBOARD_PASSWORD=change-me

# ---- Database -------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/aevrix.db

# ---- LLM provider selection ----------------------------------------------
# One of: foundry | ollama | openai_compatible | gemini | groq
LLM_PROVIDER=ollama
# Leave model blank to use the provider's configured default below.
LLM_MODEL=

# Microsoft Foundry (TEMPORARY provider - do not depend on long term)
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-05-01-preview

# Ollama (local fallback - recommended long-term free option)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI-compatible endpoint (Together, LM Studio, vLLM, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ---- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to command the bot
TELEGRAM_ALLOWED_USER_IDS=
# Only used in webhook mode (optional). Validates the secret header.
TELEGRAM_WEBHOOK_SECRET=
# polling | webhook
TELEGRAM_MODE=polling

# ---- X (Twitter) API ------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/auth/x/callback
X_SCOPES=tweet.read tweet.write users.read offline.access

# ---- LinkedIn API ---------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback
LINKEDIN_SCOPES=openid profile w_member_social
LINKEDIN_API_VERSION=202405

# ---- Optional search API (RSS works without this) -------------------------
# One of: tavily | brave | serpapi (leave blank to use RSS only)
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---- Security -------------------------------------------------------------
# REQUIRED to encrypt OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=
# Secret used to sign Telegram callback tokens and OAuth state
APP_SESSION_SECRET=change-me-to-a-long-random-string

# ---- Cost & behaviour limits ---------------------------------------------
MAX_ARTICLES_PER_RUN=50
MAX_LLM_CALLS_PER_RUN=20
MAX_X_POSTS_PER_DAY=3
MAX_LINKEDIN_POSTS_PER_WEEK=4
RESEARCH_WINDOW_HOURS=24
REQUIRE_HUMAN_APPROVAL=true
AUTO_PUBLISH=false
