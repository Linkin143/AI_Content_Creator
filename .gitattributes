# Keep shell scripts + Linux service files LF even when committed from Windows,
# so git-cloned deploys on the Oracle VM run without CRLF (\r) errors.
*.sh            text eol=lf
*.service       text eol=lf
*.timer         text eol=lf
Caddyfile       text eol=lf
deploy/**       text eol=lf

# Windows-only launchers stay CRLF.
*.bat           text eol=crlf
*.ps1           text eol=crlf
