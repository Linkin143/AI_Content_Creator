[Unit]
# AEVRIX Streamlit dashboard on port 8501 (optional; proxied by Caddy).
Description=AEVRIX Dashboard (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aevrix
Group=aevrix
WorkingDirectory=/opt/aevrix
EnvironmentFile=/opt/aevrix/.env
ExecStart=/opt/aevrix/.venv/bin/python -m streamlit run app/dashboard/Home.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aevrix/data /opt/aevrix/logs

[Install]
WantedBy=multi-user.target
