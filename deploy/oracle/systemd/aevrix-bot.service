[Unit]
# AEVRIX Telegram bot (long polling). Must stay alive 24/7 for approvals.
Description=AEVRIX Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aevrix
Group=aevrix
WorkingDirectory=/opt/aevrix
EnvironmentFile=/opt/aevrix/.env
ExecStart=/opt/aevrix/.venv/bin/python -m app.cli run-bot
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aevrix/data /opt/aevrix/logs

[Install]
WantedBy=multi-user.target
