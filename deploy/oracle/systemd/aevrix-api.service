[Unit]
# AEVRIX FastAPI server (OAuth callbacks + REST API) on port 8000.
Description=AEVRIX API (FastAPI/uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aevrix
Group=aevrix
WorkingDirectory=/opt/aevrix
EnvironmentFile=/opt/aevrix/.env
# Bind to localhost only; Caddy terminates TLS and proxies to it.
ExecStart=/opt/aevrix/.venv/bin/python -m uvicorn app.api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/aevrix/data /opt/aevrix/logs

[Install]
WantedBy=multi-user.target
